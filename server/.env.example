# ===== IYS 账号后端配置 =====
# 复制成 .env 后按需修改：cp .env.example .env

# 监听地址。本机开发用 127.0.0.1；部署到服务器 / 容器时改成 0.0.0.0
HOST=127.0.0.1
PORT=3000

# SQLite 数据库文件（相对路径按 server/ 目录解析，留空默认 data/iys.db）
# DATABASE_PATH=./data/iys.db

# 放在 Nginx、Render、Railway 等反向代理后面时设为 1，否则拿到的客户端 IP 都是代理的
# TRUST_PROXY=1

# 是否顺便托管项目根目录里的 HTML 页面（同源访问，Cookie 最省事）
SERVE_STATIC=true
# PUBLIC_DIR=..

# 前端和 API 不同域名时才需要配置，逗号分隔
# ALLOWED_ORIGINS=https://www.example.com,http://localhost:5173

# 生产环境走 HTTPS 时必须为 true，否则 Cookie 不会被浏览器保存
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# 不勾选“记住我”时的会话时长（小时）
SESSION_TTL_HOURS=12
# 勾选“记住我”时的会话时长（天）
REMEMBER_TTL_DAYS=30

# 只有无法使用 Cookie 的前端（某些 App / 跨站场景）才设为 true，
# 打开后登录响应会额外返回 token，前端需自行保管（XSS 风险更高）
EXPOSE_TOKEN_IN_BODY=false
